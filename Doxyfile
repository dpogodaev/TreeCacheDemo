# Minimal Doxygen configuration. Missing keys fall back to Doxygen defaults.
# Generate the API docs with:  doxygen

PROJECT_NAME           = TreeCacheDemo
PROJECT_BRIEF          = "A change-tracking cache over a lazily loaded tree database"
OUTPUT_DIRECTORY       = docs/api
GENERATE_LATEX         = NO
QUIET                  = YES

INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp

# Everything is documented on purpose; surface anything that is not.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES

# The Q_OBJECT macro is not real C++; keep the parser from tripping on it.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = Q_OBJECT= "Q_SLOTS=" "Q_SIGNALS=public"

# No Graphviz dependency.
HAVE_DOT               = NO
